# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local (for your computer) and fill in the values.
# On Netlify, add the SAME names under Site configuration → Environment variables.
# Never share or commit the secret values. SETUP.md explains where each comes from.
# ─────────────────────────────────────────────────────────────────────────────

# Your website address, no trailing slash.
# On your computer: http://localhost:3000   Live: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "Publishable" key (or the legacy "anon public" key). Safe to show in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "Secret" key (or the legacy "service_role" key). SECRET: server only.
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments → Developer → API Keys. SECRET.
DODO_PAYMENTS_API_KEY=
# Dodo Payments → Developer → Webhooks → your endpoint → Signing secret (starts with whsec_). SECRET.
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode while testing, live_mode when you start selling for real.
DODO_PAYMENTS_ENVIRONMENT=test_mode
